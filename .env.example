# YXShop 商城系统环境配置模板
# 使用方法：cp .env.example .env，然后填入真实配置

# ========== 应用配置 ==========
APP_MODE=production
APP_DEBUG=false
APP_SECURE=true
APP_SAME_SITE=lax
APP_URL=http://localhost:8777

# CORS 跨域（逗号分隔）
CORS_ORIGINS=http://localhost:8777,http://localhost:8080

# ========== 版本授权 ==========
# open_source / commercial / enterprise / saas
APP_EDITION=open_source
# 授权码（商业版/企业版必填，开源版留空）
LICENSE_KEY=
# 授权验证服务器
LICENSE_SERVER=https://license.yxshop.com

# ========== 数据库 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yxshop_free
DB_USERNAME=root
DB_PASSWORD=

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== 缓存 ==========
CACHE_DRIVER=redis
CACHE_HOST=127.0.0.1
CACHE_PORT=6379
CACHE_PASSWORD=

# ========== 队列 ==========
QUEUE_CONNECTION=redis
QUEUE_HOST=127.0.0.1
QUEUE_PORT=6379
QUEUE_PASSWORD=

# ========== 服务端口 ==========
PORT=8777
WEBSOCKET_PORT=3131
API_PORT=3232

# ========== JWT ==========
# 生成方式: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISS=yxshop

# ========== Push 推送 ==========
PUSH_HOST=http://127.0.0.1:3232
PUSH_APP_KEY=
PUSH_APP_SECRET=
PUSH_CHANNEL_HOOK=http://127.0.0.1:8777/plugin/webman/push/hook
PUSH_AUTH=/plugin/webman/push/auth

# ========== 域名与静态资源 ==========
DOMAIN=http://127.0.0.1:8777
# 静态资源 URL 前缀（本地与 DOMAIN 一致；上线后切 OSS 只改这里）
ASSET_URL=http://127.0.0.1:8777

# ========== 支付宝配置 ==========
ALIPAY_APP_ID=
ALIPAY_APP_SECRET_CERT=
ALIPAY_APP_PUBLIC_CERT=
ALIPAY_PUBLIC_CERT=
ALIPAY_ENCRYPT_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/pay/notify/alipay
ALIPAY_RETURN_URL=https://your-domain.com/pay/return
ALIPAY_MODE=dev

# ========== 微信支付配置 ==========
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_KEY=
WECHAT_CERT_PATH=/path/to/wechat/cert.pem
WECHAT_KEY_PATH=/path/to/wechat/key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/pay/notify/wechat
WECHAT_RETURN_URL=https://your-domain.com/pay/return
WECHAT_REFUND_NOTIFY_URL=https://your-domain.com/pay/notify/wechat/refund
WECHAT_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_MODE=dev

# ========== 微信小程序（jscode2session 一键登录） ==========
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# ========== 微信扫码登录（开放平台网站应用） ==========
WECHAT_ADMIN_APPID=
WECHAT_ADMIN_SECRET=
WECHAT_ADMIN_CALLBACK_URL=http://127.0.0.1:8777/admin/api/wechat/callback
WECHAT_OFFICIAL_APPID=
WECHAT_OFFICIAL_SECRET=
WECHAT_OFFICIAL_CALLBACK_URL=http://127.0.0.1:8777/api/wechat/callback

# ========== cURL SSL 证书校验 ==========
# 生产必须 true，并配置 CURL_CA_BUNDLE 指向 cacert.pem
CURL_SSL_VERIFY=true
CURL_CA_BUNDLE=

# ========== 银联支付配置 ==========
UNIONPAY_MCH_ID=
UNIONPAY_APP_ID=
UNIONPAY_CERT_PATH=/path/to/unionpay/cert.pem
UNIONPAY_KEY_PATH=/path/to/unionpay/key.pem
UNIONPAY_NOTIFY_URL=https://your-domain.com/pay/notify/unionpay
UNIONPAY_RETURN_URL=https://your-domain.com/pay/return
UNIONPAY_MODE=dev

# ========== 对象存储（可选） ==========
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_DOMAIN=
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ========== AI 能力模块（可选） ==========
# 默认 AI 服务商：openai / anthropic
AI_DEFAULT_PROVIDER=openai

# OpenAI 配置（支持官方 API、Azure OpenAI、第三方兼容 API）
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o
AI_OPENAI_TIMEOUT=60
AI_OPENAI_MAX_TOKENS=4096
AI_OPENAI_TEMPERATURE=0.7

# Anthropic (Claude) 配置
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_ANTHROPIC_API_VERSION=2023-06-01
AI_ANTHROPIC_TIMEOUT=60
AI_ANTHROPIC_MAX_TOKENS=4096
AI_ANTHROPIC_TEMPERATURE=0.7

# 算力计费
AI_BILLING_ENABLED=true
AI_FREE_QUOTA=50

# ========== Apidoc 文档（可选） ==========
# APIDOC_AUTH_ENABLE=false
# APIDOC_PASSWORD=
# APIDOC_SECRET_KEY=
