{
  "name": "workerman/webman",
  "type": "project",
  "keywords": [
    "high performance",
    "http service"
  ],
  "homepage": "https://www.workerman.net",
  "license": "MIT",
  "description": "High performance HTTP Service Framework.",
  "authors": [
    {
      "name": "walkor",
      "email": "walkor@workerman.net",
      "homepage": "https://www.workerman.net",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "walkor@workerman.net",
    "issues": "https://github.com/walkor/webman/issues",
    "forum": "https://wenda.workerman.net/",
    "wiki": "https://workerman.net/doc/webman",
    "source": "https://github.com/walkor/webman"
  },
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "webman/database": "^2.1",
    "illuminate/pagination": "^12.3",
    "illuminate/events": "^12.3",
    "symfony/var-dumper": "^7.2",
    "webman/redis": "^2.1",
    "webman/redis-queue": "^2.1",
    "webman/cache": "^2.1",
    "webman/log": "~2.1",
    "vlucas/phpdotenv": "^5.6",
    "webman/captcha": "^1.0||^2.1",
    "webman/push": "^1.0",
    "webman/event": "^1.0",
    "workerman/crontab": "^1.0",
    "illuminate/redis": ">=8.0",
    "zoujingli/ip2region": "^2.0",
    "tinywan/jwt": "^1.10",
    "guzzlehttp/guzzle": "^7.8",
    "tinywan/storage": "^1.0",
    "ramsey/uuid": "^4.0",
    "openspout/openspout": "^4.0",
    "symfony/cache": ">=6.0",
    "psr/simple-cache": "^3.0",
    "phpmailer/phpmailer": "^6.9",
    "godruoyi/php-snowflake": ">=2.0",
    "symfony/translation": "^7.2",
    "intervention/image": "^2.7",
    "phpoffice/phpspreadsheet": "^4.1",
    "webman/gateway-worker": "^1.0",
    "overtrue/easy-sms": "^3.1",
    "hg/apidoc": "^5.3",
    "w7corp/easywechat": "^6.17",
    "illuminate/http": "^12.20",
    "tecnickcom/tcpdf": "^6.6",
    "workbunny/webman-nacos": "^1.3",
    "yansongda/pay": "^3.7",
    "symfony/yaml": "^7.3",
    "endroid/qr-code": "^6.0",
    "psr/container": "1.1.1",
    "webman/blade": "^1.5",
    "topthink/think-validate": "^3.0"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    },
    "files": [
      "app/functions.php"
    ]
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
